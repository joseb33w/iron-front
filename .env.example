# Supabase project URL (public — exposed to the browser)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Supabase anon/publishable key (public — exposed to the browser, scoped by RLS)
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx

# Per-user table prefix used to scope tables in the shared Supabase project
VITE_TABLE_PREFIX=usr_xxx
